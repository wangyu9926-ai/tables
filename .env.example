# ============ 多维表格（开放版）配置 ============
# 复制本文件为 backend/.env 后按需修改；.env 含密码不要外传

# ---- 服务 ----
PORT=8002
# dev=开发（默认密钥可用）；prod=生产（强制校验 JWT_SECRET，见下）
APP_ENV=dev
# 生产必须：至少 32 字符的随机串（示例：python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=mtables-dev-secret-please-change-32
# 登录有效期（小时）
JWT_EXPIRE_HOURS=8

# ---- 管理员引导账号（仅首次启动时创建；之后改密码去界面「用户管理」）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 业务数据库（MySQL 5.7+/8.x/PolarDB，需 JSON 支持）----
MT_DB_HOST=127.0.0.1
MT_DB_PORT=3306
MT_DB_USER=root
MT_DB_PASSWORD=
# 库名（需先建库并导入 backend/app/mtables/schema.sql）
# 想直接沿用 8002 平台里已有的多维表数据？把这里指到那个库即可（表结构完全兼容）
MT_DB_NAME=mtables
